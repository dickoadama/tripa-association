# TRIPA — variables d'environnement du serveur
# Copiez ce fichier en `.env` pour un test local.

# Base de données (par ordre de priorité)
# 1) DATABASE_URL : Postgres managé (Supabase — recommandé). Ex :
#    postgresql://postgres.xxxxxx:VOTRE_MDP@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# 2) TURSO_DATABASE_URL + TURSO_AUTH_TOKEN : Turso (libSQL) — optionnel
# TURSO_DATABASE_URL=libsql://votre-db.turso.io
# TURSO_AUTH_TOKEN=votre_jeton_turso
# 3) Rien de renseigné : base SQLite locale "server/data/tripa.db" (dev / tests)

# Secret de signature des jetons de session (mettez une longue chaîne aléatoire en production)
JWT_SECRET=changez-moi-avec-une-longue-chaine-aleatoire

# Compte Super Admin créé automatiquement au premier lancement
SUPER_ADMIN_EMAIL=superadmin@tripa.com
SUPER_ADMIN_PASSWORD=tripa-super-2026

# Port (Render injecte PORT automatiquement)
PORT=10000

# Cookies de session : true derrière HTTPS, false en HTTP simple (test local / LAN).
# Par défaut : sécurisé si NODE_ENV=production.
COOKIE_SECURE=false
