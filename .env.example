# TRIPA — Variables d'environnement (auto-hébergement).
# Ce fichier alimente `docker compose`. Copiez-le en `.env` :
#   cp .env.example .env
# (Pour un lancement « nu » sans Docker, le serveur lit `server/.env` via dotenv.)

# --- Secret (OBLIGATOIRE en production) ---
# Longue chaîne aléatoire. Ex : openssl rand -hex 32
JWT_SECRET=changez-moi-avec-une-longue-chaine-aleatoire

# --- Super Admin (créé au premier lancement) ---
SUPER_ADMIN_EMAIL=superadmin@tripa.com
SUPER_ADMIN_PASSWORD=tripa-super-2026

# --- Port exposé / écouté ---
PORT=10000

# --- Cookies ---
# true derrière un HTTPS (reverse proxy), false en HTTP simple (ex : test local / LAN).
COOKIE_SECURE=false

# --- Base de données (optionnel) ---
# Laissez vide pour la base SQLite locale (volume Docker « tripa-data »).
# Renseignez pour utiliser Turso :
# TURSO_DATABASE_URL=libsql://votre-db.turso.io
# TURSO_AUTH_TOKEN=votre_jeton_turso
